# config_sqlite.env
# Configuration alternative avec SQLite (aucune installation MySQL requise)
# Usage : cp config_sqlite.env .env

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# SQLite (fichier local, aucun serveur requis)
DB_HOST=
DB_PORT=
DB_NAME=origine_sqlite.db
DB_USER=
DB_PASS=

JWT_SECRET=dev_secret_change_in_production_32chars_minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# IA (optionnel pour tester sans IA)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=CLAUDE

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE=5242880
