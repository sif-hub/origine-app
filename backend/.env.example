# ORIGINE API - Variables d'environnement
# Copier en .env et renseigner les valeurs

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de données
# En production (ex. Neon Postgres) : renseigner DATABASE_URL directement,
# elle prend le pas sur les champs DB_* ci-dessous (utilisés pour MySQL local).
DATABASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=origine_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=change_this_secret_key_min_32_chars_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# IA (renseigner au moins une clé)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=CLAUDE

# Upload
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE=5242880

# Notifications Web Push (VAPID) — générer une paire de clés dédiée en prod
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@origine.cm
